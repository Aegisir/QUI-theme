{
  "name": "qui-theme",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @qui-theme/demo dev",
    "build": "pnpm --filter @qui-theme/ui build && pnpm --filter @qui-theme/demo build",
    "typecheck": "pnpm --filter @qui-theme/ui typecheck && pnpm --filter @qui-theme/demo typecheck",
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "verify:replica": "node scripts/verify-replica.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "baseline:build": "node scripts/freeze-baseline.mjs",
    "baseline:capture": "node scripts/verify-replica.mjs --capture --source artifacts/local/original",
    "verify:interactions": "node scripts/verify-interactions.mjs",
    "verify:performance": "node scripts/measure-performance.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm verify:bundle"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  }
}
