{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@qui-theme/ui": [
        "../../packages/qui-ui/src/index.ts"
      ],
      "@qui-theme/ui/icon": [
        "../../packages/qui-ui/src/icon.ts"
      ],
      "@qui-theme/ui/icons": [
        "../../packages/qui-ui/src/icons.ts"
      ],
      "@qui-theme/ui/icon-index": [
        "../../packages/qui-ui/src/icon-index.ts"
      ],
      "@qui-theme/ui/icon-groups": [
        "../../packages/qui-ui/src/icon-groups.ts"
      ],
      "@qui-theme/ui/theme": [
        "../../packages/qui-ui/src/theme.ts"
      ],
      "@qui-theme/ui/assets": [
        "../../packages/qui-ui/src/assets.ts"
      ],
      "@qui-theme/ui/regions": [
        "../../packages/qui-ui/src/regions.ts"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.json",
    "vite.config.ts"
  ]
}
